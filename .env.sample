# Sample environment file for local development.
#
# This is the one repository whose runtime configuration comes from `.env`:
#   * `docker compose` interpolates every runtime variable below into the container, so this file is the
#     supported way to configure `make build` / `make serve`;
#   * the API also loads `.env` itself via dotenv.net, but only in Debug builds (`make serve-local`,
#     `dotnet run`). The Docker image is built in Release, so inside Docker it reads only the process
#     environment that compose provides.
#
# In AWS these values are supplied from SSM Parameter Store (see HousingFinanceInterimApi/serverless.yml).

# --- Build -------------------------------------------------------------------
# Personal access token with read:packages on the LBHackney-IT GitHub Packages feed.
# Required by `docker compose build` (the Hackney.* packages are not on nuget.org).
LBHPACKAGESTOKEN=your-github-personal-access-token-here

# --- Runtime: SQL Server -----------------------------------------------------
# On Linux: Data Source=localhost,1433
# On Windows: Data Source=127.0.0.1,1433 locally, or Data Source=host.docker.internal,1433 using Docker
CONNECTION_STRING='Data Source=localhost,1433; Rest Of SQL Server Connection String'

# --- Runtime: environment name ----------------------------------------------
# Used to build the CloudWatch log group names for the nightly-process queries.
ENVIRONMENT_NAME=development

# --- Runtime: Google Drive / Sheets -----------------------------------------
# Service-account JSON, wrapped in single quotes and on a single line.
GOOGLE_API_KEY='{ "json": "goes here" }'

# --- Runtime: processing settings -------------------------------------------
WAIT_DURATION=30
BATCH_SIZE=250
CASH_FILE_REGEX=^regex-here$
HOUSING_FILE_REGEX=^regex-here$
ACCEPTED_ORIGINS=https://first-url.com,https://second-url.com
CHARGES_BATCH_YEARS=year1;year2;year3

# --- Runtime: S3 -------------------------------------------------------------
S3_BUCKET_NAME=s3-bucket-name
S3_OBJECT_PREFIX=prefix/path

# --- Runtime: authorisation --------------------------------------------------
# The groups allowed to call the API endpoints.
HOUSING_FINANCE_ALLOWED_GROUPS=mmh-project-team
